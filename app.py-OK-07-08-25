# --- Troncature sécurisée ---
def truncate_text_safely(text, max_tokens=8000, max_chars=12000, model_name=None):
    """Tronque intelligemment le texte : tente avec tiktoken, sinon fallback sur le nombre de caractères."""
    try:
        import tiktoken
        enc = None
        if model_name:
            try:
                enc = tiktoken.encoding_for_model(model_name)
            except Exception:
                enc = tiktoken.get_encoding("cl100k_base")
        else:
            enc = tiktoken.get_encoding("cl100k_base")
        tokens = enc.encode(text)
        if len(tokens) > max_tokens:
            tokens = tokens[:max_tokens]
            return enc.decode(tokens) + "\n[TRUNCATED]"
        return text
    except Exception:
        if len(text) > max_chars:
            return text[:max_chars] + "\n[TRUNCATED]"
        return text

# ----------------------------
# Parallélisation Adaptative (AIMD)
# ----------------------------
async def summarize_chunk_async(llm, prompt, chunk, content_type):
    return await asyncio.to_thread(
        llm.invoke,
        prompt.format(text=chunk.page_content, content_type=content_type)
    )

async def adaptive_map_reduce(docs, llm, prompt, content_type, initial_window=2, max_window=16, timeout=60):
    results = []
    window = initial_window
    idx = 0
    N = len(docs)
    errors_in_a_row = 0

    while idx < N:
        now = time.time()
        end = min(idx + window, N)
        batch = docs[idx:end]
        try:
            coros = [
                summarize_chunk_async(llm, prompt, chunk, content_type)
                for chunk in batch
            ]
            partials = await asyncio.wait_for(asyncio.gather(*coros), timeout=timeout)
            results.extend([p.content.strip() for p in partials if p and p.content.strip()])
            if window < max_window:
                window = min(window * 2, max_window)
            idx = end
            errors_in_a_row = 0
        except Exception as e:
            window = max(1, window // 2)
            errors_in_a_row += 1
            if errors_in_a_row >= 3:
                raise RuntimeError(f"Trop d'erreurs de résumé: {e}")
            await asyncio.sleep(2)
        finally:
            elapsed = time.time() - now
            if elapsed > timeout * 0.8:
                window = max(1, window // 2)
    return results

def summarize_text(docs, lang_code="fr", content_type="general"):
    llm = get_llm()
    prompts = PROMPT_TEMPLATES.get(lang_code, PROMPT_TEMPLATES["fr"])
    length_threshold = 8000
    if content_type in ("scientific", "technical"):
        length_threshold = 6000

    if sum(len(d.page_content) for d in docs) < length_threshold:
        full_text = "\n\n".join(d.page_content for d in docs if d.page_content)
        return llm.invoke(prompts["stuff"].format(text=full_text, content_type=CONTENT_TYPES[content_type])).content.strip()

    async def _summarize():
        partials = await adaptive_map_reduce(
            docs, llm, prompts["map"], CONTENT_TYPES[content_type],
            initial_window=2, max_window=16, timeout=60
        )
        combined = "\n\n".join(partials)
        combined = truncate_text_safely(
            combined,
            max_tokens=8000,
            max_chars=12000,
            model_name=MODEL
        )
        return llm.invoke(prompts["combine"].format(text=combined, content_type=CONTENT_TYPES[content_type])).content.strip()

    return asyncio.run(_summarize())

def generate_thumbnail(summary: str, summary_lang_name: str):
    llm = get_llm()
    prompt_gen_prompt = (
        f"A text summary is provided in {summary_lang_name}. Your task is to write a single-line image prompt in ENGLISH to illustrate it. "
        "Describe a clear visual scene with concrete attributes (place, mood, subject). Do not include any overlay text. "
        "Output ONLY the image prompt, without quotes.\n\n"
        f"Summary:\n{summary}"
    )
    image_prompt = llm.invoke(prompt_gen_prompt).content.strip()
    try:
        r = requests.post(IMAGE_API_URL, json={"prompt": image_prompt}, timeout=60)
        r.raise_for_status()
        img = Image.open(BytesIO(r.content))
        return img, image_prompt
    except Exception as e:
        st.error(f"Image generation failed: {e}")
        return None, image_prompt


OPENAI_API_KEY = os.getenv("OPENAI_API_KEY", "")
BASE_URL = os.getenv("OPENAI_BASE_URL") or os.getenv("OPENAI_API_BASE")

LLM_ARGS = {"model": MODEL, "temperature": 0.2}
if OPENAI_API_KEY:
    LLM_ARGS["api_key"] = OPENAI_API_KEY
if BASE_URL:
    LLM_ARGS["base_url"] = BASE_URL


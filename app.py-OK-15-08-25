def truncate_text_safely(text, max_tokens=8000, max_chars=12000, model_name=None):
    try:
        import tiktoken
        enc = tiktoken.encoding_for_model(model_name) if model_name else tiktoken.get_encoding("cl100k_base")
        tokens = enc.encode(text)
        if len(tokens) > max_tokens:
            return enc.decode(tokens[:max_tokens]) + "\n[TRUNCATED]"
        return text
    except Exception:
        return text[:max_chars] + "\n[TRUNCATED]" if len(text) > max_chars else text

async def summarize_chunk_async(llm, prompt, chunk, content_type):
    return await asyncio.to_thread(llm.invoke, prompt.format(text=chunk.page_content, content_type=content_type))

async def adaptive_map_reduce(docs, llm, prompt, content_type, initial_window=2, max_window=16, timeout=60):
    results, window, idx, N, errors_in_a_row = [], initial_window, 0, len(docs), 0
    while idx < N:
        now, end = time.time(), min(idx + window, N)
        try:
            coros = [summarize_chunk_async(llm, prompt, chunk, content_type) for chunk in docs[idx:end]]
            partials = await asyncio.wait_for(asyncio.gather(*coros), timeout=timeout)
            results.extend([p.content.strip() for p in partials if p and p.content.strip()])
            if window < max_window:
                window = min(window * 2, max_window)
            idx, errors_in_a_row = end, 0
        except Exception as e:
            window, errors_in_a_row = max(1, window // 2), errors_in_a_row + 1
            if errors_in_a_row >= 3:
                raise RuntimeError(f"Too many summary errors: {e}")
            await asyncio.sleep(2)
        if time.time() - now > timeout * 0.8:
            window = max(1, window // 2)
    return results

def summarize_text(docs, lang_code="fr", content_type="general"):
    llm = get_llm()
    prompts = PROMPT_TEMPLATES.get(lang_code, PROMPT_TEMPLATES["fr"])
    threshold = 6000 if content_type in ("scientific", "technical") else 8000

    if sum(len(d.page_content) for d in docs) < threshold:
        full_text = "\n\n".join(d.page_content for d in docs if d.page_content)
        return llm.invoke(
            prompts["stuff"].format(text=full_text, content_type=CONTENT_TYPES[content_type])
        ).content.strip()

    async def _summarize():
        partials = await adaptive_map_reduce(docs, llm, prompts["map"], CONTENT_TYPES[content_type])
        combined = truncate_text_safely("\n\n".join(partials), model_name=MODEL)
        return llm.invoke(
            prompts["combine"].format(text=combined, content_type=CONTENT_TYPES[content_type])
        ).content.strip()

    return asyncio.run(_summarize())

def generate_thumbnail(summary: str, summary_lang_name: str):
    """
    1) Génère un prompt d'image en anglais via le LLM texte.
    2) Appelle l'endpoint OpenAI-compatible /v1/images/generations sur IMAGE_BASE_URL avec IMAGE_API_KEY.
    """
    # Prompt d'image (EN)
    llm = get_llm()
    prompt = (
        f"A text summary is provided in {summary_lang_name}. Your task is to write a single-line image prompt in ENGLISH to illustrate it. "
        "Describe a clear visual scene with concrete attributes (place, mood, subject). Do not include any overlay text. "
        "Output ONLY the image prompt, without quotes.\n\nSummary:\n{summary}"
    )
    image_prompt = llm.invoke(prompt.format(summary=summary)).content.strip()

    # Si aucune clé image, on ne tente pas l'appel
    if not IMAGE_API_KEY:
        return None, image_prompt

    url = f"{IMAGE_BASE_URL.rstrip('/')}/images/generations"
    headers = {"Authorization": f"Bearer {IMAGE_API_KEY}"}
    payload = {
        "model": IMAGE_MODEL,
        "prompt": image_prompt,
        "size": IMAGE_SIZE,
        "n": 1,
        "response_format": "b64_json",
        # "background": "transparent",  # décommente si supporté par ta passerelle
    }

    try:
        r = requests.post(url, json=payload, headers=headers, timeout=120)
        r.raise_for_status()
        data = r.json()
        b64 = data["data"][0].get("b64_json")
        if b64:
            img = Image.open(BytesIO(base64.b64decode(b64)))
            return img, image_prompt
    except Exception as e:
        print("Image generation error:", e)

    return None, image_prompt


    selected_lang_name = st.selectbox("Summary Language:", list(LANGUAGES.values()), index=1)
    content_type = st.selectbox("Content Type:", list(CONTENT_TYPES.values()), index=0)
    lang_code = [code for code, name in LANGUAGES.items() if name == selected_lang_name][0]
    content_key = [key for key, value in CONTENT_TYPES.items() if value == content_type][0]
    st.write(f"Text Model: `{MODEL}`")
    st.write(f"Image Model: `{IMAGE_MODEL}` @ `{IMAGE_SIZE}`")
    st.caption(
        "Set OPENAI_API_KEY and (optional) OPENAI_BASE_URL/OPENAI_API_BASE for the text LLM. "
        "Set IMAGE_API_KEY (optional, fallback to OPENAI_API_KEY) and IMAGE_BASE_URL for image generation.\n"
        "IMAGE_BASE_URL defaults to https://api.openai.com/v1"
    )

col_input, col_pdf = st.columns([2, 1])
user_text_or_url = col_input.text_area("Enter a URL or paste text to summarize:", height=180)
uploaded = col_pdf.file_uploader("... or upload a PDF file", type=["pdf"])

source_text = ""
if uploaded:
    with st.spinner("Extracting text from PDF..."):
        source_text = read_pdf_to_text(uploaded)
        if not source_text:
            st.error("Could not extract text from this PDF.")
elif user_text_or_url:
    if validators.url(user_text_or_url):
        if not user_text_or_url.startswith(("http://", "https://")):
            st.error("Unsupported URL (must be http or https).")
        else:
            with st.spinner("Loading page..."):
                try:
                    source_text = load_url_to_text(user_text_or_url)
                except Exception as e:
                    st.error(f"Could not load URL: {e}")
    else:
        source_text = user_text_or_url

if source_text:
    with st.spinner(f"Splitting and summarizing in {selected_lang_name}..."):
        docs = split_to_docs(source_text, content_key)
        summary = summarize_text(docs, lang_code, content_key) if docs else ""
    if summary:
        col1, col2 = st.columns([3, 1], gap="large")
        with col1:
            st.subheader(f"Summary ({selected_lang_name})")
            st.write(summary)
        with st.spinner("Creating thumbnail..."):
            img, image_prompt = generate_thumbnail(summary, selected_lang_name)
        with col2:
            st.subheader("Thumbnail")
            if img:
                st.image(img, use_container_width=True)
            if image_prompt:
                st.caption(image_prompt)
else:
    st.info("Enter a URL, paste text, or upload a PDF to begin.")

import os
import requests
from io import BytesIO

import streamlit as st
from dotenv import load_dotenv
from PIL import Image
import pdfplumber
import validators

from langchain.docstore.document import Document
from langchain.text_splitter import RecursiveCharacterTextSplitter
from langchain.prompts import PromptTemplate
from langchain_community.document_loaders import WebBaseLoader
from langchain_openai import ChatOpenAI


# --------------------
# Config & Environment
# --------------------
load_dotenv()

MODEL = os.getenv("OPENAI_API_MODEL", "ai-summary")
OPENAI_API_KEY = os.getenv("OPENAI_API_KEY", "")
BASE_URL = os.getenv("OPENAI_BASE_URL") or os.getenv("OPENAI_API_BASE") or None
IMAGE_API_URL = os.getenv("IMAGE_API_URL", "https://api-txt2image.c0.ai-dev.numerique-interieur.com/generate_image/")

LLM_ARGS = {"model": MODEL, "temperature": 0.2}
if OPENAI_API_KEY:
    LLM_ARGS["api_key"] = OPENAI_API_KEY
if BASE_URL:
    LLM_ARGS["base_url"] = BASE_URL

# Supported languages for the summary
LANGUAGES = {
    "en": "English",
    "fr": "Français",
    "es": "Español",
    "de": "Deutsch",
}


# -------------
# Cached Client
# -------------
@st.cache_resource(show_spinner=False)
def get_llm() -> ChatOpenAI:
    return ChatOpenAI(**LLM_ARGS)


# ---------------
# Cached Utilities
# ---------------
@st.cache_data(show_spinner=False)
def read_pdf_to_text(file) -> str:
    """Extract text from a PDF with pdfplumber."""
    try:
        file.seek(0)
        with pdfplumber.open(file) as pdf:
            pages = [page.extract_text() or "" for page in pdf.pages]
            return "\n".join(pages).strip()
    except Exception:
        return ""


@st.cache_data(show_spinner=False)
def load_url_to_text(url: str) -> str:
    """Load a web page and return concatenated text."""
    loader = WebBaseLoader(url)
    docs = loader.load()
    return "\n\n".join([d.page_content for d in docs if d.page_content])


@st.cache_data(show_spinner=False)
def split_to_docs(text: str):
    """Token-aware chunking."""
    splitter = RecursiveCharacterTextSplitter.from_tiktoken_encoder(chunk_size=2000, chunk_overlap=200)
    chunks = splitter.split_text(text)
    return [Document(page_content=c) for c in chunks if c.strip()]


# ------------------------
# Prompts (Multilingual)
# ------------------------
PROMPT_TEMPLATES = {
    "en": {
        "stuff": PromptTemplate(input_variables=["text"], template="You are an assistant writing in English. Clearly and faithfully summarize the text, using structure (titles, bullets) if useful.\n\nText:\n{text}\n\nSummary (in English):"),
        "map": PromptTemplate(input_variables=["text"], template="You are an assistant writing in English. Summarize the following passage clearly and concisely.\n\nPassage:\n{text}\n\nSummary (in English):"),
        "combine": PromptTemplate(input_variables=["text"], template="You are an assistant writing in English. You will be given partial summaries. Produce a final, clear, concise, and faithful summary with a readable structure.\n\nPartial Summaries:\n{text}\n\nFinal Summary (in English):"),
    },
    "fr": {
        "stuff": PromptTemplate(input_variables=["text"], template="Tu es un assistant qui rédige en français. Résume clairement, fidèlement et de façon structurée (titres, puces si utile).\n\nTexte:\n{text}\n\nRésumé (en français):"),
        "map": PromptTemplate(input_variables=["text"], template="Tu es un assistant qui rédige en français. Résume le passage suivant de manière claire et concise.\n\nPassage:\n{text}\n\nRésumé (en français):"),
        "combine": PromptTemplate(input_variables=["text"], template="Tu es un assistant qui rédige en français. Tu reçois des résumés partiels. Produit un résumé final clair, concis, fidèle, avec une structure lisible.\n\nRésumés partiels:\n{text}\n\nRésumé final (en français):"),
    },
    "es": {
        "stuff": PromptTemplate(input_variables=["text"], template="Eres un asistente que escribe en español. Resume el texto de forma clara, fiel y estructurada (títulos, viñetas si es útil).\n\nTexto:\n{text}\n\nResumen (en español):"),
        "map": PromptTemplate(input_variables=["text"], template="Eres un asistente que escribe en español. Resume el siguiente pasaje de forma clara y concisa.\n\nPasaje:\n{text}\n\nResumen (en español):"),
        "combine": PromptTemplate(input_variables=["text"], template="Eres un asistente que escribe en español. Recibirás resúmenes parciales. Produce un resumen final claro, conciso, fiel y con una estructura legible.\n\nResúmenes parciales:\n{text}\n\nResumen final (en español):"),
    },
    "de": {
        "stuff": PromptTemplate(input_variables=["text"], template="Sie sind ein Assistent, der auf Deutsch schreibt. Fassen Sie den Text klar, getreu und strukturiert zusammen (Titel, Aufzählungszeichen, falls nützlich).\n\nText:\n{text}\n\nZusammenfassung (auf Deutsch):"),
        "map": PromptTemplate(input_variables=["text"], template="Sie sind ein Assistent, der auf Deutsch schreibt. Fassen Sie den folgenden Abschnitt klar und prägnant zusammen.\n\nAbschnitt:\n{text}\n\nZusammenfassung (auf Deutsch):"),
        "combine": PromptTemplate(input_variables=["text"], template="Sie sind ein Assistent, der auf Deutsch schreibt. Sie erhalten Teil-Zusammenfassungen. Erstellen Sie eine endgültige, klare, prägnante und getreue Zusammenfassung mit einer lesbaren Struktur.\n\nTeil-Zusammenfassungen:\n{text}\n\nEndgültige Zusammenfassung (auf Deutsch):"),
    }
}


# ----------------------------
# Summarizer & Image Generator
# ----------------------------
def summarize_text(docs, lang_code="fr"):
    """Adaptive: direct (stuff) for short inputs; manual map–reduce for long."""
    llm = get_llm()
    prompts = PROMPT_TEMPLATES.get(lang_code, PROMPT_TEMPLATES["fr"]) # Default to French

    if sum(len(d.page_content) for d in docs) < 8000:
        full_text = "\n\n".join(d.page_content for d in docs if d.page_content)
        return llm.invoke(prompts["stuff"].format(text=full_text)).content.strip()

    partials = [
        llm.invoke(prompts["map"].format(text=d.page_content)).content.strip()
        for d in docs if d.page_content.strip()
    ]
    combined = "\n\n".join(p for p in partials if p)
    return llm.invoke(prompts["combine"].format(text=combined)).content.strip()


def generate_thumbnail(summary: str, summary_lang_name: str):
    """Create an English image prompt from a summary, then call the image API."""
    llm = get_llm()
    prompt_gen_prompt = (
        f"A text summary is provided in {summary_lang_name}. Your task is to write a single-line image prompt in ENGLISH to illustrate it. "
        "Describe a clear visual scene with concrete attributes (place, mood, subject). Do not include any overlay text. "
        "Output ONLY the image prompt, without quotes.\n\n"
        f"Summary:\n{summary}"
    )
    image_prompt = llm.invoke(prompt_gen_prompt).content.strip()

    try:
        r = requests.post(IMAGE_API_URL, json={"prompt": image_prompt}, timeout=60)
        r.raise_for_status()
        img = Image.open(BytesIO(r.content))
        return img, image_prompt
    except Exception as e:
        st.error(f"Image generation failed: {e}")
        return None, image_prompt


# -----
#  UI
# -----
st.set_page_config(page_title="Summarizer + Thumbnail", page_icon="📝", layout="wide")
st.title("📝 Summarizer + Thumbnail")

with st.expander("Settings", expanded=False):
    selected_lang_name = st.selectbox(
        "Summary Language:",
        options=list(LANGUAGES.values()),
        index=1 # Default to French
    )
    # Get language code from selected name
    lang_code = [code for code, name in LANGUAGES.items() if name == selected_lang_name][0]

    st.write(f"Model: `{MODEL}`")
    st.caption(
        "Set OPENAI_API_KEY and (optional) OPENAI_BASE_URL for an OpenAI-compatible gateway. "
        "Set IMAGE_API_URL to change the image service."
    )

col_input, col_pdf = st.columns([2, 1])
with col_input:
    user_text_or_url = st.text_area("Enter a URL or paste text to summarize:", height=180)
with col_pdf:
    uploaded = st.file_uploader("... or upload a PDF file", type=["pdf"])

source_text = ""
if uploaded is not None:
    with st.spinner("Extracting text from PDF..."):
        source_text = read_pdf_to_text(uploaded)
        if not source_text:
            st.error("Could not extract text from this PDF.")
elif user_text_or_url:
    if validators.url(user_text_or_url):
        if not user_text_or_url.startswith(("http://", "https://")):
            st.error("Unsupported URL (must be http or https).")
        else:
            with st.spinner("Loading page..."):
                try:
                    source_text = load_url_to_text(user_text_or_url)
                except Exception as e:
                    st.error(f"Could not load URL: {e}")
    else:
        source_text = user_text_or_url

if source_text:
    with st.spinner(f"Splitting and summarizing in {selected_lang_name}..."):
        docs = split_to_docs(source_text)
        summary = summarize_text(docs, lang_code) if docs else ""

    if summary:
        with st.spinner("Creating thumbnail..."):
            img, image_prompt = generate_thumbnail(summary, selected_lang_name)

        col1, col2 = st.columns([3, 1], gap="large")
        with col1:
            st.subheader(f"Summary ({selected_lang_name})")
            st.write(summary)
        with col2:
            st.subheader("Thumbnail")
            st.caption(image_prompt)
            if img:
                st.image(img, use_container_width=True)
else:
    st.info("Enter a URL, paste text, or upload a PDF to begin.")

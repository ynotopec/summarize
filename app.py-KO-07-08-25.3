# Configure logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

# Load environment variables
load_dotenv()

# Configuration
@dataclass
class Config:
    MODEL: str = os.getenv("OPENAI_API_MODEL", "mistral-small-vllm")
    OPENAI_API_KEY: str = os.getenv("OPENAI_API_KEY", "")
    BASE_URL: str = os.getenv("OPENAI_BASE_URL") or os.getenv("OPENAI_API_BASE")
    IMAGE_API_URL: str = os.getenv("IMAGE_API_URL")
    
    # Chunking parameters
    CHUNK_SIZES: Dict[str, int] = None
    CHUNK_OVERLAPS: Dict[str, int] = None
    
    # Processing parameters
    MAX_TOKENS: int = 8000
    MAX_CHARS: int = 12000
    TIMEOUT: int = 60
    MAX_RETRIES: int = 3
    
    def __post_init__(self):
        self.CHUNK_SIZES = {
            "general": 2000,
            "news": 2000,
            "scientific": 1500,
            "technical": 1500
        }
        self.CHUNK_OVERLAPS = {
            "general": 200,
            "news": 200,
            "scientific": 150,
            "technical": 150
        }

config = Config()

# Constants
LANGUAGES = {"en": "English", "fr": "Français", "es": "Español", "de": "Deutsch"}
CONTENT_TYPES = {
    "general": "General Text",
    "news": "News Article",
    "scientific": "Scientific Paper",
    "technical": "Technical Documentation"
}

# Prompt templates with better structure
PROMPT_TEMPLATES = {
    "en": {
        "stuff": """You are an assistant writing in English. Clearly and faithfully summarize the {content_type}, using structure (titles, bullets) if useful.

Text:
{text}

Summary (in English):""",
        "map": """You are an assistant writing in English. Summarize the following {content_type} clearly and concisely.

Passage:
{text}

Summary (in English):""",
        "combine": """You are an assistant writing in English. You will be given partial summaries of a {content_type}. Produce a final, clear, concise, and faithful summary with a readable structure.

Partial Summaries:
{text}

Final Summary (in English):"""
    },
    "fr": {
        "stuff": """Tu es un assistant qui rédige en français. Résume clairement, fidèlement et de façon structurée (titres, puces si utile) le {content_type}.

Texte:
{text}

Résumé (en français):""",
        "map": """Tu es un assistant qui rédige en français. Résume le passage suivant de manière claire et concise pour un {content_type}.

Passage:
{text}

Résumé (en français):""",
        "combine": """Tu es un assistant qui rédige en français. Tu reçois des résumés partiels d'un {content_type}. Produit un résumé final clair, concis, fidèle, avec une structure lisible.

Résumés partiels:
{text}

Résumé final (en français):"""
    }
}

# Convert to PromptTemplate objects
for lang in PROMPT_TEMPLATES:
    for key in PROMPT_TEMPLATES[lang]:
        PROMPT_TEMPLATES[lang][key] = PromptTemplate(
            input_variables=["text", "content_type"],
            template=PROMPT_TEMPLATES[lang][key]
        )

@st.cache_resource(show_spinner=False)
def get_llm() -> ChatOpenAI:
    """Initialize and cache the LLM instance."""
    llm_args = {"model": config.MODEL, "temperature": 0.2}
    if config.OPENAI_API_KEY:
        llm_args["api_key"] = config.OPENAI_API_KEY
    if config.BASE_URL:
        llm_args["base_url"] = config.BASE_URL
    return ChatOpenAI(**llm_args)

@st.cache_data(show_spinner=False, ttl=3600)
def read_pdf_to_text(file_bytes: bytes) -> str:
    """Extract text from PDF with better error handling."""
    try:
        with pdfplumber.open(BytesIO(file_bytes)) as pdf:
            texts = []
            for page in pdf.pages:
                text = page.extract_text()
                if text:
                    texts.append(text.strip())
            return "\n".join(texts)
    except Exception as e:
        logger.error(f"PDF extraction error: {e}")
        return ""

@st.cache_data(show_spinner=False, ttl=3600)
def load_url_to_text(url: str) -> str:
    """Load and cache URL content."""
    try:
        loader = WebBaseLoader(url)
        docs = loader.load()
        return "\n\n".join([d.page_content for d in docs if d.page_content])
    except Exception as e:
        logger.error(f"URL loading error: {e}")
        raise

@lru_cache(maxsize=128)
def get_text_splitter(content_type: str) -> RecursiveCharacterTextSplitter:
    """Get cached text splitter for content type."""
    return RecursiveCharacterTextSplitter(
        chunk_size=config.CHUNK_SIZES.get(content_type, 2000),
        chunk_overlap=config.CHUNK_OVERLAPS.get(content_type, 200),
        length_function=len,
        separators=["\n\n", "\n", ". ", " ", ""]
    )

def split_to_docs(text: str, content_type: str) -> List[Document]:
    """Split text into documents with optimized chunking."""
    splitter = get_text_splitter(content_type)
    chunks = splitter.split_text(text)
    return [Document(page_content=chunk) for chunk in chunks if chunk.strip()]

def truncate_text_safely(text: str, max_tokens: int = None, max_chars: int = None) -> str:
    """Truncate text safely with token counting."""
    max_tokens = max_tokens or config.MAX_TOKENS
    max_chars = max_chars or config.MAX_CHARS
    
    try:
        import tiktoken
        enc = tiktoken.encoding_for_model(config.MODEL)
        tokens = enc.encode(text)
        if len(tokens) > max_tokens:
            return enc.decode(tokens[:max_tokens]) + "\n[TRUNCATED]"
        return text
    except Exception:
        # Fallback to character-based truncation
        if len(text) > max_chars:
            return text[:max_chars] + "\n[TRUNCATED]"
        return text

async def summarize_chunk_with_retry(
    llm: ChatOpenAI,
    prompt: PromptTemplate,
    chunk: Document,
    content_type: str,
    max_retries: int = 3
) -> Optional[str]:
    """Summarize a chunk with retry logic."""
    for attempt in range(max_retries):
        try:
            result = await asyncio.to_thread(
                llm.invoke,
                prompt.format(text=chunk.page_content, content_type=content_type)
            )
            return result.content.strip()
        except Exception as e:
            if attempt == max_retries - 1:
                logger.error(f"Failed to summarize chunk after {max_retries} attempts: {e}")
                return None
            await asyncio.sleep(2 ** attempt)  # Exponential backoff

async def adaptive_map_reduce(
    docs: List[Document],
    llm: ChatOpenAI,
    prompt: PromptTemplate,
    content_type: str,
    initial_window: int = 3,
    max_window: int = 10
) -> List[str]:
    """Improved adaptive map-reduce with better error handling."""
    results = []
    window = initial_window
    idx = 0
    N = len(docs)
    
    while idx < N:
        end = min(idx + window, N)
        batch = docs[idx:end]
        
        try:
            # Process batch with timeout
            tasks = [
                summarize_chunk_with_retry(llm, prompt, chunk, content_type)
                for chunk in batch
            ]
            
            batch_results = await asyncio.wait_for(
                asyncio.gather(*tasks, return_exceptions=True),
                timeout=config.TIMEOUT
            )
            
            # Filter successful results
            valid_results = [
                r for r in batch_results 
                if isinstance(r, str) and r
            ]
            
            if valid_results:
                results.extend(valid_results)
                # Increase window on success
                window = min(window + 1, max_window)
            else:
                # Decrease window on failure
                window = max(1, window // 2)
                
            idx = end
            
        except asyncio.TimeoutError:
            logger.warning(f"Timeout processing batch {idx}-{end}")
            window = max(1, window // 2)
            
        except Exception as e:
            logger.error(f"Error in batch processing: {e}")
            window = max(1, window // 2)
    
    return results

def summarize_text(docs: List[Document], lang_code: str = "fr", content_type: str = "general") -> str:
    """Main summarization function with optimizations."""
    llm = get_llm()
    prompts = PROMPT_TEMPLATES.get(lang_code, PROMPT_TEMPLATES["fr"])
    content_type_name = CONTENT_TYPES[content_type]
    
    # Calculate total text length
    total_length = sum(len(d.page_content) for d in docs)
    threshold = 6000 if content_type in ("scientific", "technical") else 8000
    
    # Direct summarization for short texts
    if total_length < threshold:
        full_text = "\n\n".join(d.page_content for d in docs if d.page_content)
        try:
            result = llm.invoke(
                prompts["stuff"].format(text=full_text, content_type=content_type_name)
            )
            return result.content.strip()
        except Exception as e:
            logger.error(f"Direct summarization failed: {e}")
            return ""
    
    # Map-reduce for longer texts
    async def _summarize():
        try:
            # Map phase
            partials = await adaptive_map_reduce(
                docs, llm, prompts["map"], content_type_name
            )
            
            if not partials:
                return ""
            
            # Combine phase
            combined = truncate_text_safely("\n\n".join(partials))
            result = llm.invoke(
                prompts["combine"].format(text=combined, content_type=content_type_name)
            )
            return result.content.strip()
            
        except Exception as e:
            logger.error(f"Map-reduce summarization failed: {e}")
            return ""
    
    return asyncio.run(_summarize())

@st.cache_data(show_spinner=False, ttl=3600)
def generate_thumbnail(summary: str, summary_lang_name: str) -> Tuple[Optional[Image.Image], Optional[str]]:
    """Generate thumbnail with caching."""
    if not config.IMAGE_API_URL:
        return None, None
    
    llm = get_llm()
    prompt = (
        f"A text summary is provided in {summary_lang_name}. Your task is to write a single-line image prompt in ENGLISH to illustrate it. "
        "Describe a clear visual scene with concrete attributes (place, mood, subject). Do not include any overlay text. "
        f"Output ONLY the image prompt, without quotes.\n\nSummary:\n{summary[:500]}"  # Limit summary length
    )
    
    try:
        image_prompt = llm.invoke(prompt).content.strip()
        
        # Request image with timeout
        response = requests.post(
            config.IMAGE_API_URL,
            json={"prompt": image_prompt},
            timeout=30
        )
        response.raise_for_status()
        
        image = Image.open(BytesIO(response.content))
        return image, image_prompt
        
    except Exception as e:
        logger.error(f"Thumbnail generation failed: {e}")
        return None, image_prompt if 'image_prompt' in locals() else None

# --- Streamlit UI ---
def main():
    st.set_page_config(
        page_title="Summarizer + Thumbnail",
        page_icon="📝",
        layout="wide",
        initial_sidebar_state="collapsed"
    )
    
    st.title("📝 Summarizer + Thumbnail")
    
    # Settings in expander
    with st.expander("⚙️ Settings", expanded=False):
        col1, col2 = st.columns(2)
        with col1:
            selected_lang_name = st.selectbox(
                "Summary Language:",
                list(LANGUAGES.values()),
                index=1
            )
            lang_code = next(code for code, name in LANGUAGES.items() if name == selected_lang_name)
        
        with col2:
            content_type = st.selectbox(
                "Content Type:",
                list(CONTENT_TYPES.values()),
                index=0
            )
            content_key = next(key for key, value in CONTENT_TYPES.items() if value == content_type)
        
        st.info(f"**Model:** `{config.MODEL}`")
        if not config.OPENAI_API_KEY:
            st.warning("⚠️ OPENAI_API_KEY not set in environment")
    
    # Input section
    col_input, col_pdf = st.columns([2, 1])
    
    with col_input:
        user_text_or_url = st.text_area(
            "Enter a URL or paste text to summarize:",
            height=180,
            placeholder="https://example.com or paste your text here..."
        )
    
    with col_pdf:
        uploaded = st.file_uploader(
            "... or upload a PDF file",
            type=["pdf"],
            help="Upload a PDF document to extract and summarize its content"
        )
    
    # Process input
    source_text = ""
    
    if uploaded:
        with st.spinner("📄 Extracting text from PDF..."):
            # Read file as bytes for caching
            file_bytes = uploaded.read()
            source_text = read_pdf_to_text(file_bytes)
            if not source_text:
                st.error("❌ Could not extract text from this PDF.")
    
    elif user_text_or_url:
        if validators.url(user_text_or_url):
            if not user_text_or_url.startswith(("http://", "https://")):
                st.error("❌ Unsupported URL (must be http or https).")
            else:
                with st.spinner("🌐 Loading page..."):
                    try:
                        source_text = load_url_to_text(user_text_or_url)
                    except Exception as e:
                        st.error(f"❌ Could not load URL: {e}")
        else:
            source_text = user_text_or_url
    
    # Generate summary if we have source text
    if source_text:
        # Show text statistics
        with st.expander("📊 Text Statistics", expanded=False):
            col1, col2, col3 = st.columns(3)
            col1.metric("Characters", f"{len(source_text):,}")
            col2.metric("Words", f"{len(source_text.split()):,}")
            col3.metric("Estimated reading time", f"{len(source_text.split()) // 200} min")
        
        # Split and summarize
        with st.spinner(f"🤖 Splitting and summarizing in {selected_lang_name}..."):
            docs = split_to_docs(source_text, content_key)
            
            if not docs:
                st.error("❌ No content to summarize.")
                return
            
            # Progress bar for long texts
            if len(docs) > 5:
                progress_bar = st.progress(0)
                progress_text = st.empty()
                progress_text.text(f"Processing {len(docs)} chunks...")
            
            summary = summarize_text(docs, lang_code, content_key)
            
            if len(docs) > 5:
                progress_bar.progress(1.0)
                progress_text.empty()
        
        if summary:
            # Display results
            col1, col2 = st.columns([3, 1], gap="large")
            
            with col1:
                st.subheader(f"📝 Summary ({selected_lang_name})")
                
                # Add copy button
                st.code(summary, language=None)
                
                # Summary statistics
                with st.expander("Summary Statistics", expanded=False):
                    original_words = len(source_text.split())
                    summary_words = len(summary.split())
                    compression_ratio = (1 - summary_words / original_words) * 100
                    
                    col_stat1, col_stat2, col_stat3 = st.columns(3)
                    col_stat1.metric("Summary words", f"{summary_words:,}")
                    col_stat2.metric("Compression ratio", f"{compression_ratio:.1f}%")
                    col_stat3.metric("Chunks processed", len(docs))
            
            # Generate thumbnail if API is available
            if config.IMAGE_API_URL:
                with col2:
                    st.subheader("🖼️ Thumbnail")
                    
                    with st.spinner("🎨 Creating thumbnail..."):
                        img, image_prompt = generate_thumbnail(summary, selected_lang_name)
                    
                    if img:
                        st.image(img, use_container_width=True)
                        
                        # Add download button for image
                        buf = BytesIO()
                        img.save(buf, format="PNG")
                        st.download_button(
                            label="Download Image",
                            data=buf.getvalue(),
                            file_name="summary_thumbnail.png",
                            mime="image/png"
                        )
                    
                    if image_prompt:
                        with st.expander("Image Prompt", expanded=False):
                            st.caption(image_prompt)
            
            # Export options
            st.divider()
            with st.expander("💾 Export Options", expanded=False):
                col_exp1, col_exp2, col_exp3 = st.columns(3)
                
                # Download summary as text
                with col_exp1:
                    st.download_button(
                        label="📄 Download Summary (TXT)",
                        data=summary,
                        file_name=f"summary_{lang_code}.txt",
                        mime="text/plain"
                    )
                
                # Download summary as markdown
                with col_exp2:
                    markdown_content = f"# Summary\n\n**Language:** {selected_lang_name}\n**Content Type:** {content_type}\n\n{summary}"
                    st.download_button(
                        label="📝 Download Summary (MD)",
                        data=markdown_content,
                        file_name=f"summary_{lang_code}.md",
                        mime="text/markdown"
                    )
                
                # Download combined report
                with col_exp3:
                    report = f"""SUMMARY REPORT
==================
Language: {selected_lang_name}
Content Type: {content_type}
Original Length: {len(source_text):,} characters
Summary Length: {len(summary):,} characters
Compression Ratio: {(1 - len(summary) / len(source_text)) * 100:.1f}%

SUMMARY
==================
{summary}

IMAGE PROMPT
==================
{image_prompt if 'image_prompt' in locals() and image_prompt else 'N/A'}
"""
                    st.download_button(
                        label="📊 Download Full Report",
                        data=report,
                        file_name=f"summary_report_{lang_code}.txt",
                        mime="text/plain"
                    )
        else:
            st.error("❌ Failed to generate summary. Please try again.")
    
    else:
        # Welcome message when no input
        st.info("👋 Enter a URL, paste text, or upload a PDF to begin.")
        
        # Show examples
        with st.expander("📚 Examples", expanded=True):
            st.markdown("""
            **Try these examples:**
            - 🌐 **URL:** `https://en.wikipedia.org/wiki/Artificial_intelligence`
            - 📄 **Text:** Copy and paste any article or document
            - 📑 **PDF:** Upload any PDF file (research papers, reports, etc.)
            
            **Tips for best results:**
            - Choose the appropriate content type for better summaries
            - Scientific papers and technical docs use smaller chunks for accuracy
            - The summary language can be different from the source language
            """)

# Error boundary wrapper
def run_app():
    try:
        main()
    except Exception as e:
        st.error(f"An unexpected error occurred: {e}")
        st.error("Please refresh the page and try again.")
        logger.exception("Application error")

if __name__ == "__main__":
    run_app()



